<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <!-- Contingut principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Veure més"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/settings_24px"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Configuració"
                app:tint="#1A1A1A" />

        </LinearLayout>

        <!-- Etiqueta secció -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:text="Eines de Plantzone"
            android:textSize="14sp"
            android:textColor="#444444"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/label_background" />

        <!-- Grid de eines -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <GridLayout
                android:id="@+id/gridEines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:useDefaultMargins="false">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardIdentificar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_camera" app:tint="#3A9E5F" android:contentDescription="Identificar" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Identificar" android:textSize="13sp" android:textColor="#1A1A1A" android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDiagnosticar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/medical_services_24px" app:tint="#E87B2E" android:contentDescription="Diagnosticar" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Diagnosticar" android:textSize="13sp" android:textColor="#1A1A1A" android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardJardi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/eco_24px" app:tint="#3A9E5F" android:contentDescription="Jardí" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Jardí" android:textSize="13sp" android:textColor="#1A1A1A" android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fila 2 buida -->
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />

                <!-- Fila 3 buida -->
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />

                <!-- Fila 4 buida -->
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#DCDCDC" app:cardElevation="0dp" />

            </GridLayout>
        </ScrollView>

    </LinearLayout>

    <!-- NAVBAR — declarat abans del FAB -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled" />

    <!-- FAB CÀMERA — declarat l'últim = sempre per sobre -->
    <ImageButton
        android:id="@+id/fabCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="29dp"
        android:src="@drawable/ic_camera"
        android:contentDescription="Càmera"
        android:background="@drawable/fab_circle_background"
        android:padding="14dp"
        android:elevation="16dp"
        app:tint="@android:color/white" />

</FrameLayout>