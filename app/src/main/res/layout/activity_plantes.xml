<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="72dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#3A9E5F"
                    app:strokeWidth="1.5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_menu_search"
                            android:contentDescription="Cerca"
                            app:tint="#888888" />
                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Buscar plantes"
                            android:textColorHint="#AAAAAA"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A"
                            android:background="@null"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:inputType="text" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- SECTION: Preferits -->
            <TextView
                android:id="@+id/tvPreferits"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Preferits" android:textSize="16sp" android:textStyle="bold"
                android:textColor="#1A1A1A" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/gridPreferits"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp" android:weightSum="2">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E0E0">
                    <ImageView android:id="@+id/ivPlant1" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/potted_plant_24px" android:contentDescription="Planta preferida 1" />
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginStart="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E0E0">
                    <ImageView android:id="@+id/ivPlant2" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/local_florist_24px" android:contentDescription="Planta preferida 2" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- SECTION: Plantes -->
            <TextView
                android:id="@+id/tvPlantes"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Plantes" android:textSize="16sp" android:textStyle="bold"
                android:textColor="#1A1A1A" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/gridPlantes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp" android:weightSum="2">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E0E0">
                    <ImageView android:id="@+id/ivPlant3" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/local_florist_24px" android:contentDescription="Planta 3" />
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginStart="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E0E0">
                    <ImageView android:id="@+id/ivPlant4" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/potted_plant_24px" android:contentDescription="Planta 4" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- SECTION: Vull tenir -->
            <TextView
                android:id="@+id/tvVullTenir"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Vull tenir" android:textSize="16sp" android:textStyle="bold"
                android:textColor="#1A1A1A" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/gridVullTenir"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp" android:weightSum="2">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E0E0">
                    <ImageView android:id="@+id/ivPlant5" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/potted_plant_24px" android:contentDescription="Planta desitjada 1" />
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginStart="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E0E0E0">
                    <ImageView android:id="@+id/ivPlant6" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/local_florist_24px" android:contentDescription="Planta desitjada 2" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TOP BAR — declarat després del scroll per quedar per sobre -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:background="#F0F0F0"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:layout_gravity="top">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="El meu jardí" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A1A1A" />
        <TextView
            android:id="@+id/tvTemp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="10°-12°" android:textSize="14sp" android:textColor="#555555" android:layout_marginEnd="6dp" />
        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_upload_you_tube" android:contentDescription="Temps" />

    </LinearLayout>

    <!-- NAVBAR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled" />

    <!-- FAB CÀMERA — declarat l'últim = sempre per sobre -->
    <ImageButton
        android:id="@+id/fabCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="29dp"
        android:src="@drawable/ic_camera"
        android:contentDescription="Càmera"
        android:background="@drawable/fab_circle_background"
        android:padding="14dp"
        android:elevation="16dp"
        app:tint="@android:color/white" />

</FrameLayout>