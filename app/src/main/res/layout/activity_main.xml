<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgray">

    <!-- Ciudad y clima -->
    <TextView
        android:id="@+id/txtCiudad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barcelona"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/txtTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10°-12°"
        app:layout_constraintTop_toTopOf="@id/txtCiudad"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <!-- Buscador -->
    <EditText
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Buscar plantes"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtCiudad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <!-- Botones -->
    <LinearLayout
        android:id="@+id/menuOpciones"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <com.google.android.material.button.MaterialButton
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Identificar"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textTop"
            app:iconPadding="8dp"
            app:iconSize="32dp"
            android:backgroundTint="@color/green_500"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:backgroundTint="@color/orange_500"
            android:text="Diagnosticar"
            android:textSize="13.5dp"
            app:icon="@drawable/ic_health"
            app:iconGravity="textTop"
            app:iconPadding="8dp"
            app:iconSize="32dp" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:backgroundTint="@color/green_500"
            android:text="Jardí"
            app:icon="@drawable/ic_plant"
            app:iconGravity="textTop"
            app:iconPadding="8dp"
            app:iconSize="32dp" />

    </LinearLayout>

    <!-- Tendencias -->
    <TextView
        android:id="@+id/txtTendencias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tendències a Barcelona"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/menuOpciones"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <GridLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="2"
        app:layout_constraintTop_toBottomOf="@id/txtTendencias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="#DDDDDD"
            android:layout_margin="8dp"
            android:layout_marginRight="30dp"/>

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="#DDDDDD"
            android:layout_margin="8dp"/>
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>