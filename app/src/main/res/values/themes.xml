<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Plantzone" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_500</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/green_500</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorSurface">@color/blue_50</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Estil global del menú inferior -->
        <item name="bottomNavigationStyle">@style/MyBottomNav</item>
    </style>

    <style name="Theme.Plantzone" parent="Base.Theme.Plantzone" />

    <style name="MyBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/green_500</item>
        <item name="itemTextColor">@color/green_500</item>
        <item name="android:background">@color/white</item>
    </style>
</resources>